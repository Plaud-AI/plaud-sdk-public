<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating Tab Bar -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="272dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_tab"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Home Tab -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabHomeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/tabHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Home"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Files Tab -->
        <LinearLayout
            android:id="@+id/tabFiles"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabFilesIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Files"
                android:src="@drawable/ic_files" />

            <TextView
                android:id="@+id/tabFilesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Files"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Settings Tab -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabSettingsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/tabSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Settings"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
