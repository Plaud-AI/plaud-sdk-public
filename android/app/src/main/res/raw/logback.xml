<?xml version="1.0" encoding="UTF-8"?>
<!-- Overrides the SDK's res/raw/logback.xml via Android resource merging (app wins over AAR).
     Same policy as the SDK default except totalSizeCap raised 100MB → 500MB so multi-round
     stress-test logs are not evicted before export. -->
<configuration>
    <!-- LOG_DIR is set programmatically in the SDK's Logger -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <immediateFlush>true</immediateFlush>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/plaud_sdk_%d{yyyy-MM-dd_HH}_%i.log</fileNamePattern>

            <!-- Max size of a single log file -->
            <maxFileSize>20MB</maxFileSize>

            <!-- Keep 7 days of hourly files (7 x 24) -->
            <maxHistory>168</maxHistory>

            <!-- Total size cap across all log files -->
            <totalSizeCap>500MB</totalSizeCap>

            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>
</configuration>
